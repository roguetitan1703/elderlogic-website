      {
        "selector": "JSXOpeningElement[name.name='PhoneShot'] > JSXAttribute[name.name='shot'] > Literal[value!=/^(?:assessment|visit-form|route)$/]",
        "message": "<PhoneShot> shot must be one of 'assessment' | 'visit-form' | 'route'."
