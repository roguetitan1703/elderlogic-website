        "selector": "JSXOpeningElement[name.name='PhoneShot'] > JSXAttribute > JSXIdentifier[name!=/^(?:shot|width|caption|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<PhoneShot> doesn't accept that prop. Declared props: shot, width, caption, assetBase, style."
