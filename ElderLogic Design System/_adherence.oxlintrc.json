      {
        "selector": "JSXOpeningElement[name.name='PhoneRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:shots|captions|width|stagger|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<PhoneRow> doesn't accept that prop. Declared props: shots, captions, width, stagger, assetBase, style."
