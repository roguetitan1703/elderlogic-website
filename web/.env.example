# Where enquiries from the contact form are written.
#
# With these unset the form still posts to /api/contact, the enquiry is logged
# on the server, and the reader is told it did not send and given the email
# address. That is deliberate: a success message the site cannot back up is
# worse than no form.
#
# AIRTABLE_TOKEN     a personal access token on the base. The site itself only
#                    needs data.records:write. Add schema.bases:read and
#                    schema.bases:write if you want scripts/airtable-setup.py
#                    to create the fields for you.
# AIRTABLE_BASE_ID   the base id, "app...", the first path segment of the
#                    Airtable URL
# AIRTABLE_TABLE     the table id, "tbl...", the second path segment. The table
#                    name works too, but the id survives a rename.
#
# The table needs these fields, spelled exactly:
#   Name, Organisation, Email, Message, Received, Source
# Run `cd web && python ../scripts/airtable-setup.py` to create any that are
# missing, or add them by hand. Extra fields are ignored, not touched.
#
# Put real values in web/.env.local, which is gitignored. Never in this file.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Enquiries

# Optional. Any webhook that should receive an enquiry Airtable would not take,
# after three retries. A Slack incoming webhook works as it is. Without this
# the enquiry is still recoverable from the ENQUIRY_UNSTORED log line.
ENQUIRY_FALLBACK_URL=

# The public origin. Left empty on purpose: this file gets copied to
# .env.local, and a copy carrying a value would turn a developer's machine into
# "the live site", which switches on indexing and Google Analytics locally.
#
# The value is https://elderlogic.app. The apex is canonical and www redirects
# to it, so it never carries a www.
#
# Set it on the production deployment only. A preview that has it still serves
# noindex, because Vercel marks previews VERCEL_ENV=preview, but a second
# production deployment carrying it would compete with the real site in search.
# It is the last variable to set, not the first: until it exists the whole site
# serves noindex, nofollow and robots.txt agrees.
NEXT_PUBLIC_SITE_URL=

